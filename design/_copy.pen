                      "name": "inner",
                      "width": "fill_container",
                      "stroke": {
                        "align": "inside",
                        "thickness": {
                          "bottom": 1
                        },
                        "fill": "#eeeeee"
                      },
                      "layout": "vertical",
                      "gap": 5,
                      "padding": 20,
                      "children": [
                        {
                          "type": "text",
                          "id": "AMfuF",
                          "name": "heading",
                          "fill": "#202020",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Orchestration is going to become mor...",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "5Q8lF",
                          "name": "description",
                          "fill": "#6F6F6B",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "I have a feeling that, for coding, orchestration tooling for AI agents will become more...",
                          "lineHeight": 1.3,
                          "fontFamily": "Inter",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
