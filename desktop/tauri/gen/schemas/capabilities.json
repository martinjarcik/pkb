{
  "default": {
    "identifier": "default",
    "description": "Default capability for the main window",
    "local": true,
    "windows": ["main"],
    "permissions": [
      "core:default",
      "core:window:allow-start-dragging",
      "fs:default",
      { "identifier": "fs:allow-write-file", "allow": [{ "path": "**" }] },
      { "identifier": "fs:allow-mkdir", "allow": [{ "path": "**" }] },
      { "identifier": "fs:allow-exists", "allow": [{ "path": "**" }] }
    ]
  }
}
