{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pkb",
  "version": "0.1.0",
  "identifier": "com.mjarcik.pkb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    },
    "windows": [
      {
        "title": "pkb",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 26 }
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
